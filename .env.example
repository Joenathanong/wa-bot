# ============================================================
# TELEGRAM -> WHATSAPP BRIDGE - environment configuration
# Copy this file to ".env" and fill in the values.
# NEVER commit the real .env file.
# ============================================================

# --- SUMBER PESAN ---------------------------------------------------
# bot  = pesan dibaca oleh Bot Telegram Anda sendiri.
#        HANYA bisa membaca pesan manusia. Telegram TIDAK PERNAH
#        mengirimkan pesan dari BOT LAIN ke bot Anda.
# user = pesan dibaca lewat AKUN Telegram Anda (MTProto/GramJS), read-only.
#        Ini satu-satunya cara membaca peringatan yang dikirim BOT LAIN
#        di dalam sebuah Grup. Bot tetap dipakai untuk Admin Menu.
# both = keduanya.
TELEGRAM_SOURCE=user

# Bot token dari @BotFather (WAJIB - dipakai untuk Admin Menu)
TELEGRAM_BOT_TOKEN=

# Telegram user ID yang boleh membuka /admin (WAJIB).
# Pisahkan dengan koma untuk banyak admin.
# Cari ID Anda dengan mengirim /id ke bot ini.
ADMIN_TELEGRAM_IDS=

# Chat ID Telegram yang pesannya boleh diproses.
# Pisahkan dengan koma. Contoh: -1001234567890,123456789
# Kosongkan = semua chat diproses (TIDAK disarankan untuk produksi).
# Cari ID chat/grup dengan mengirim /id di chat tersebut.
TELEGRAM_ALLOWED_CHAT_IDS=

# Jeda minimum antar pengiriman pesan WhatsApp (milidetik). Minimal 3000.
MESSAGE_DELAY_MS=3000

# production | development
NODE_ENV=production

# --- MODE AKUN (wajib bila TELEGRAM_SOURCE=user atau both) -----------
# Ambil gratis di https://my.telegram.org > API development tools
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Transport MTProto. true = WebSocket Secure lewat port 443 (menyerupai HTTPS,
# lolos firewall kantor). false = TCP polos lewat port 80, sering dicekik
# firewall sehingga muncul "Error: TIMEOUT" di log.
# Cek jaringan Anda dengan: npm run tg:diag
# TELEGRAM_USE_WSS=true
# TELEGRAM_CONNECTION_RETRIES=100
# TELEGRAM_RETRY_DELAY_MS=3000

# Level log bawaan GramJS: error | warn | info | debug | none
# Setel "none" bila baris TIMEOUT-nya terlalu berisik.
# GRAMJS_LOG_LEVEL=error

# Setelah diisi, login sekali:  npm run tg:login
# Lalu cari Chat ID grup sumber: npm run tg:chats

# --- PENGGABUNGAN PESAN MENTION -------------------------------------
# Bot pengirim kerap memecah satu peringatan jadi "(bagian 1/2)" dan
# "(bagian 2/2)". Semua bagian tetap diteruskan, tetapi pesan mention
# hanya dikirim SEKALI setelah rentetan berhenti selama rentang ini.
# 0 = kirim mention untuk setiap peringatan (perilaku lama).
# FOLLOWUP_WINDOW_MS=15000
# FOLLOWUP_MAX_WAIT_MS=120000

# --- KETAHANAN 24 JAM -----------------------------------------------
# Setiap berapa milidetik koneksi diperiksa (dan disambung ulang bila mati).
# HEALTH_CHECK_MS=60000

# Susulan: saat aplikasi start / koneksi pulih, berapa pesan terakhir per chat
# yang diperiksa, dan seberapa lama ke belakang masih dianggap layak diteruskan.
# Proteksi duplikat memastikan pesan tidak pernah terkirim dua kali.
# CATCHUP_LIMIT=25
# CATCHUP_MAX_AGE_MINUTES=180
# Setelah mati listrik / restart: hanya peringatan TERAKHIR yang belum
# terkirim yang diteruskan (kriteria keyword tetap berlaku). Peringatan lama
# ditandai sudah diproses supaya group tidak dibanjiri data basi.
# Isi false untuk kembali mengirim seluruh peringatan tertinggal.
# CATCHUP_ONLY_LATEST=true

# --- WINDOWS SERVICE (opsional) -------------------------------------
# Bila diisi, service berjalan sebagai akun Windows ini, bukan LocalSystem.
# Akun tersebut harus punya hak "Log on as a service".
# Berguna bila Chrome gagal dijalankan di mode LocalSystem.
# SERVICE_ACCOUNT=nama_user_windows
# SERVICE_PASSWORD=
# SERVICE_DOMAIN=
# SERVICE_NAME=Telegram WA Bridge

# ---------- opsional ----------
# Lokasi file database SQLite (relatif terhadap folder project)
# DB_PATH=data/bot.db

# Level log: debug | info | warn | error
# LOG_LEVEL=info

# Berkas log. Wajib ada saat berjalan sebagai Windows Service karena tidak
# ada terminal. Bawaan: data/app.log (berputar pada 5 MB). Matikan: off
# LOG_FILE=data/app.log

# Client ID sesi WhatsApp (ubah hanya jika Anda tahu konsekuensinya)
# WA_CLIENT_ID=telegram-wa-bridge

# Path Chrome/Edge di mesin ini, jika Chromium bawaan Puppeteer bermasalah.
# Contoh Windows: C:\Program Files\Google\Chrome\Application\chrome.exe
# CHROME_PATH=

# Sematkan build WhatsApp Web tertentu bila build terbaru memecahkan
# whatsapp-web.js (mis. daftar group gagal dimuat dengan error "r").
# Daftar versi: https://github.com/wppconnect-team/wa-version/tree/main/html
# WA_WEB_VERSION=2.3000.1015901307

# Batas menunggu WhatsApp mencapai status "ready" setelah login (milidetik).
# Bila terlampaui, koneksi dibangun ulang otomatis. 0 = tanpa batas.
# WA_READY_TIMEOUT_MS=120000


# ============================================================
# LAPORAN BERKALA IEG OCS (Fulfilment Dashboard -> WhatsApp)
# ============================================================
# Uji dulu tanpa mengirim WhatsApp:  npm run ocs:test
OCS_ENABLED=false
OCS_BASE_URL=https://ocs.iegsystem.id
OCS_USERNAME=
OCS_PASSWORD=
OCS_DATABASE=EJI_WMS
OCS_TIMEOUT_MS=20000

# Kosong = semua group aktif. Isi JID (120363...@g.us) atau nama group,
# dipisah koma, untuk mengirim laporan ke group khusus saja.
OCS_GROUP_IDS=

# Jadwal
OCS_INTERVAL_MINUTES=60
# true = laporan pertama menunggu pergantian jam agar jatuh di menit :00
OCS_ALIGN_TO_HOUR=true
# Jam kerja saja, contoh 7-21. Kosongkan untuk 24 jam.
OCS_ACTIVE_HOURS=7-21

# Zona waktu untuk batas hari dan penulisan jam (420 = WIB / UTC+7)
OCS_TZ_OFFSET_MINUTES=420
OCS_TZ_LABEL=WIB

# Filter dashboard - sama persis dengan yang ada di halaman web
# dueDate = Batas Kirim, createdDate = Tanggal Pesanan
OCS_DATE_TYPE=dueDate
OCS_SHOP=All
OCS_CHANNEL=All
OCS_AREA=All
OCS_SHIFT=All
OCS_ROLE=all

# Tampilan pesan
OCS_TITLE=FULFILMENT DASHBOARD
OCS_TOP_OPERATORS=10

# Peringkat operator: month = rata-rata/hari bulan berjalan, today = hari ini
OCS_LEADERBOARD_PERIOD=month
OCS_LEADERBOARD_ROLES=packer,picker
OCS_LEADERBOARD_EXCLUDE=mesin,system
# auto | calendar | angka tetap
OCS_LEADERBOARD_DAYS=auto
# hari libur mingguan untuk mode calendar (0=Minggu)
OCS_LEADERBOARD_OFFDAYS=

# true = kirim hanya bila ada SLA terlewat / mendekati SLA / instan belum dikirim
OCS_ONLY_WHEN_PROBLEM=false
OCS_ALERT_BREACHED_SLA=1
OCS_ALERT_AT_RISK=1
OCS_ALERT_INSTAN=1

# Tenggat proses berhenti (ms). Bila shutdown belum selesai - biasanya karena
# Chrome/WhatsApp Web menggantung - proses dihentikan paksa, supaya
# `net stop` pada Windows Service tidak pernah macet di STOP_PENDING.
SHUTDOWN_TIMEOUT_MS=10000

# --- LAPORAN STOK MENIPIS -------------------------------------------
# Menarik Stocks > View V2 (stok) dan Report > Order > Sku (penjualan),
# lalu mengirim daftar SKU yang stoknya menipis pada JAM TERTENTU.
# Hampir semua nilai di bawah bisa diubah dari Telegram tanpa restart.
STOCK_ENABLED=false
# Jam kirim waktu lokal, dipisah koma. Kosong = belum ada jadwal.
# Dari Telegram: /stokjam 8,12,16
STOCK_HOURS=
# Kosong = semua WhatsApp Group aktif. Boleh JID atau nama group.
# Dari Telegram: /stokgroup <JID atau nama>
STOCK_GROUP_IDS=
# Stok di bawah angka ini dianggap menipis. Dari Telegram: /stokambang
# Kriteria utama: tampilkan SKU yang stoknya cukup kurang dari sekian hari.
# 0 = matikan saringan DOI. Dari Telegram: /stokdoi
STOCK_DOI_MAX=7
# Batas jumlah stok. 0 = TANPA batas (bawaan) karena DOI sudah jadi
# kriterianya. Dari Telegram: /stokambang
STOCK_THRESHOLD=0
# Abaikan SKU yang rata-ratanya di bawah ini. 0 = tampilkan semua.
# Dari Telegram: /stokminavg
STOCK_MIN_AVG=0
# Kategori di halaman View V2 dan status yang diambil
STOCK_CATEGORY=Sku
STOCK_ACTIVE_ONLY=true
# Jendela hari untuk Avg Daily Sales. Dari Telegram: /stokhari
STOCK_SALES_DAYS=30
# OCS menjawab 504 bila diminta 90 hari sekaligus - permintaan dipecah
# sebesar ini. Turunkan ke 15 bila masih timeout.
STOCK_CHUNK_DAYS=15
# winsor = semua hari ikut, lonjakan ekstrem dibatasi persentil (bawaan)
# full   = semua hari tanpa batas
# normal = buang payday & double date
# median = median harian
STOCK_AVG_MODE=winsor
STOCK_PERCENTILE=95
# Payday dianggap mulai tanggal berapa
STOCK_PAYDAY_FROM=25
# Jumlah SKU paling mendesak yang ditampilkan. Dari Telegram: /stoktop
STOCK_TOP=20
STOCK_SHOW_DETAIL=true
STOCK_TITLE=STOK MENIPIS
#
# Nama & nomor PIC laporan stok TIDAK disimpan di sini, melainkan di
# database lewat /stokpic dan /stokwa. Terpisah dari PIC lock stock.

# --- PERINGATAN LOCK STOCK ------------------------------------------
# Memeriksa SKU yang stok ter-reserve-nya MELEBIHI stok tersedia, lalu
# mengirim satu pesan per Shop ke PIC masing-masing. Shop dicari dari
# Master Sku Rack (/master/sku-rack).
LOCK_ENABLED=false
LOCK_INTERVAL_MINUTES=60
# Pemeriksaan PERTAMA setelah aplikasi hidup (menit). Jangan disamakan
# dengan jeda penuh: service yang sering di-restart tidak akan pernah
# sampai ke pemeriksaan pertamanya kalau harus menunggu satu jam.
LOCK_FIRST_RUN_MINUTES=3
# Jeda digeser ACAK +/- sekian menit tiap putaran, supaya permintaan tidak
# jatuh di detik yang sama persis tiap jam. 0 = tepat waktu.
LOCK_JITTER_MINUTES=7
# Kosong = 24 jam. Contoh jam kerja saja: 7-21
LOCK_ACTIVE_HOURS=
# Kosong = semua group aktif. Dari Telegram: /lockgroup
LOCK_GROUP_IDS=
# Daftar shop yang dikenal; dipakai juga untuk menebak shop dari kode SKU
# bila SKU belum terdaftar di Master Sku Rack.
LOCK_SHOPS=NCO,Hanasui,FYNE,EOMMA
LOCK_ACTIVE_ONLY=true
# Kosong = semua kategori / semua area
LOCK_CATEGORY=
LOCK_AREA=
# Master Sku Rack jarang berubah - disimpan sementara sekian menit
LOCK_RACK_CACHE_MINUTES=180
# true = jangan ulangi pesan yang isinya sama persis. Dari Telegram: /lockulang
LOCK_ONLY_ON_CHANGE=false
# Tabel dibungkus blok monospace agar kolomnya lurus di WhatsApp
LOCK_MONOSPACE=true
LOCK_MAX_ROWS=40
#
# Nama & nomor PIC TIDAK disimpan di sini, melainkan di database lewat:
#   /lockpic NCO Ibu Manda
#   /lockwa  NCO 6281234567890
